---
import { config } from '@/lib/server/config'
import { ARTICLE_CONTENT_MAX_WIDTH_CLASS, ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS } from '@/consts'

interface Props {
  fullWidth?: boolean
}

const { fullWidth = false } = Astro.props
const widthClass = fullWidth ? ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS : ARTICLE_CONTENT_MAX_WIDTH_CLASS
const currentYear = new Date().getFullYear()
const since = +config.since
---

<footer class={`mx-auto mt-12 w-full px-4 text-stone-400 dark:text-stone-500 ${widthClass}`}>
  <hr class="border-stone-200 dark:border-stone-800" />
  <p class="my-4 text-sm">
    © {config.author} {since === currentYear || !since ? currentYear : `${since} - ${currentYear}`}
  </p>
</footer>
