---
import '@blog/styles/fonts.css'
import '@/styles/globals.css'
import '@jihuayu/notion-astro/styles.css'
import { config } from '@/lib/server/config'
import Header from '@blog/components/Header.astro'
import Footer from '@blog/components/Footer.astro'
import { ARTICLE_CONTENT_MAX_WIDTH_CLASS, ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS } from '@/consts'
import type { Locale, RegionPolicy } from '@jihuayu/site-policy'

interface AlternateLink {
  hreflang: string
  href: string
}

interface Props {
  title?: string
  description?: string
  region: RegionPolicy
  locale: Locale
  fullWidth?: boolean
  articleTitle?: string | null
  searchIndexUrl?: string
  canonicalPath?: string
  alternates?: AlternateLink[]
  article?: boolean
  translationAvailable?: boolean
}

const {
  title,
  description,
  region,
  locale,
  fullWidth = false,
  articleTitle = null,
  searchIndexUrl,
  canonicalPath,
  alternates = [],
  article = false,
  translationAvailable = true
} = Astro.props

const pageTitle = title ? `${title} | ${config.title}` : config.title
const lang = locale === 'en' ? 'en' : 'zh-CN'
const site = (config.link || 'https://blog.jihuayu.com').replace(/\/$/, '')
const canonicalHref = canonicalPath
  ? new URL(canonicalPath, `${site}/`).toString()
  : undefined
const appearance = config.appearance || 'auto'
const dayBg = config.lightBackground || '#ffffff'
const nightBg = config.darkBackground || '#0c0a09'
const wrapperFont = config.font === 'serif' ? 'font-serif' : 'font-sans'
const contentWidthClass = fullWidth ? ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS : ARTICLE_CONTENT_MAX_WIDTH_CLASS
const mainClass = article
  ? 'flex-grow transition-all'
  : `flex-grow transition-all self-center w-full px-4 ${contentWidthClass}`
---

<!doctype html>
<html lang={lang} class="color-scheme-unset" data-region={region} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {alternates.map(item => (
      <link rel="alternate" hreflang={item.hreflang} href={item.href} />
    ))}
    <link rel="icon" href="/favicon-mark-light-512.png" type="image/png" sizes="256x256" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-mark-dark-512.png" type="image/png" sizes="256x256" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={config.title} href={locale === 'en' ? '/en/feed' : '/feed'} />
    {appearance === 'auto' ? (
      <>
        <meta name="theme-color" content={dayBg} media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content={nightBg} media="(prefers-color-scheme: dark)" />
      </>
    ) : (
      <meta name="theme-color" content={appearance === 'dark' ? nightBg : dayBg} />
    )}
    <script is:inline define:vars={{ appearance }}>
      (() => {
        const root = document.documentElement
        const media = window.matchMedia('(prefers-color-scheme: dark)')
        const apply = () => {
          const dark = appearance === 'dark' || (appearance === 'auto' && media.matches)
          root.classList.toggle('dark', dark)
          root.classList.remove('color-scheme-unset')
        }
        apply()
        if (appearance !== 'auto') return
        const onChange = () => apply()
        if (typeof media.addEventListener === 'function') media.addEventListener('change', onChange)
        else if (typeof media.addListener === 'function') media.addListener(onChange)
      })()
    </script>
    <slot name="head" />
    {article && (
      <>
        <script src="/scripts/reading-progress.js" defer></script>
        <script src="/scripts/code-copy.js" defer></script>
        <script src="/scripts/toc.js" defer></script>
        <script src="/scripts/lightbox.js" defer></script>
        <script src="/scripts/mermaid.js" defer></script>
        <script src="/scripts/link-preview.js" defer></script>
        <script src="/scripts/wide-toc.js" defer></script>
      </>
    )}
    <script src="/scripts/header-behavior.js" defer></script>
  </head>
  <body class="bg-day dark:bg-night" data-search-index={searchIndexUrl}>
    <div id="top">
      <div class={`wrapper ${wrapperFont}`}>
        <Header
          locale={locale}
          articleTitle={articleTitle}
          translationAvailable={translationAvailable}
          fullWidth={fullWidth}
        />
        <main class={mainClass}>
          {article && (
            <div class="fixed top-0 left-0 right-0 z-50 h-0.5 pointer-events-none">
              <div
                id="reading-progress-bar"
                class="h-full bg-stone-400 dark:bg-stone-500 transition-transform duration-75 ease-out will-change-transform"
                style="transform:scaleX(0);transform-origin:left center"
              ></div>
            </div>
          )}
          <slot />
        </main>
        <Footer fullWidth={fullWidth} />
      </div>
    </div>
  </body>
</html>
