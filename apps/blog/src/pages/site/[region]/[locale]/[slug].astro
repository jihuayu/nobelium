---
import ArticleLayout from '@blog/layouts/ArticleLayout.astro'
import CommentsIsland from '@blog/components/CommentsIsland'
import TagItem from '@blog/components/TagItem.astro'
import { getAllVariants, localePrefix } from '@blog/lib/variants'
import {
  filterGroupsForVariant,
  getPostHref,
  loadTranslationGroups,
  shouldRenderComments
} from '@blog/lib/policy-content'
import { loadArticleRenderModel } from '@blog/lib/render-article'
import { loadPageMaps } from '@blog/lib/page-maps'
import { buildHreflangLinks } from '@blog/lib/urls'
import { getPostFormatClassNames } from '@blog/lib/post-format'
import { getBlogCopy } from '@blog/lib/blog-copy'
import { getHeadingAnchorId, renderNotionArticleHtml } from '@jihuayu/notion-astro'
import { formatDate } from '@/lib/formatDate'
import { config } from '@/lib/server/config'
import {
  ARTICLE_CONTENT_MAX_WIDTH_CLASS,
  ARTICLE_TOC_LEFT,
  ARTICLE_TOC_MAX_HEIGHT,
  ARTICLE_TOC_TOP_PX,
  ARTICLE_TOC_WIDTH_PX,
  ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS
} from '@/consts'
import type { Locale, RegionPolicy } from '@jihuayu/site-policy'

export async function getStaticPaths() {
  const groups = await loadTranslationGroups(true)
  const variants = getAllVariants()
  const paths = []

  for (const { region, locale } of variants) {
    for (const group of filterGroupsForVariant(groups, region, locale)) {
      paths.push({ params: { region, locale, slug: group.contentKey } })
    }
  }

  return paths
}

const { region, locale, slug } = Astro.params as { region: RegionPolicy, locale: Locale, slug: string }
const groups = await loadTranslationGroups(true)
const group = groups.find(item => item.contentKey === slug)
if (!group) throw new Error(`Missing translation group for ${slug}`)

const entry = group.translations[locale]
if (!entry) throw new Error(`Missing locale ${locale} for ${slug}`)

const { pageLinkMap, pagePreviewMap } = await loadPageMaps()
const model = await loadArticleRenderModel(entry.pageId, pageLinkMap, pagePreviewMap)
if (!model) throw new Error(`Failed to render ${slug}`)

const showComments = shouldRenderComments(group, region)
const publicSlugPath = getPostHref(group, locale)
const dateLang = locale === 'en' ? 'en-US' : config.lang
const otherLocale: Locale = locale === 'en' ? 'zh-CN' : 'en'
const hasOtherLocale = Boolean(group.translations[otherLocale])
const articleHtml = renderNotionArticleHtml(model, { locale })
const copy = getBlogCopy(locale)
const fullWidth = entry.fullWidth
const contentWidthClass = fullWidth ? ARTICLE_WIDE_CONTENT_MAX_WIDTH_CLASS : ARTICLE_CONTENT_MAX_WIDTH_CLASS
const isPage = entry.type === 'Page'
const homeHref = localePrefix(locale) || '/'
const formatClasses = getPostFormatClassNames(entry.formats).join(' ')
---

<ArticleLayout
  region={region}
  locale={locale}
  title={entry.title}
  description={entry.summary}
  fullWidth={fullWidth}
  articleTitle={entry.title}
  canonicalPath={publicSlugPath}
  alternates={buildHreflangLinks(group, locale)}
  translationAvailable={hasOtherLocale}
>
  <article class:list={['flex flex-col items-center', formatClasses]}>
    <h1 class={`w-full font-serif font-semibold text-[2rem] leading-tight tracking-[-0.025em] text-stone-900 dark:text-stone-100 ${contentWidthClass} px-4`}>{entry.title}</h1>
    {!isPage && (
      <nav class={`w-full flex mt-6 items-start text-sm text-stone-400 dark:text-stone-500 ${contentWidthClass} px-4`}>
        <div class="flex mb-4">
          <a href={config.socialLink || '#'} class="flex hover:text-stone-700 dark:hover:text-stone-300 transition-colors duration-150 ease-out">
            <p class="ml-2 md:block">{config.author}</p>
          </a>
          <span class="block">&nbsp;/&nbsp;</span>
        </div>
        <div class="mr-2 mb-4 md:ml-0">
          {formatDate(entry.date, dateLang, config.timezone)}
        </div>
        {entry.tags?.length > 0 && (
          <div class="flex flex-nowrap max-w-full overflow-x-auto article-tags">
            {entry.tags.map(tag => <TagItem tag={tag} locale={locale} />)}
          </div>
        )}
      </nav>
    )}
    <div class="self-stretch -mt-4 relative">
      <div class={`mx-auto w-full ${contentWidthClass} px-4`}>
        <div set:html={articleHtml} />
      </div>
      {!fullWidth && model.toc.length > 0 && (
        <div
          class="hidden xl:block absolute top-0 bottom-0"
          style={`left:${ARTICLE_TOC_LEFT};width:${ARTICLE_TOC_WIDTH_PX}px`}
        >
          <nav
            data-toc
            aria-label="Table of contents"
            class="sticky pt-3 overflow-y-auto pl-2 text-sm text-stone-400 dark:text-stone-500"
            style={`top:${ARTICLE_TOC_TOP_PX}px;max-height:min(${ARTICLE_TOC_MAX_HEIGHT}, 100%)`}
          >
            {model.toc.map(item => (
              <div>
                <a
                  href={`#${getHeadingAnchorId(item.id)}`}
                  class="block w-full py-1 text-left whitespace-nowrap overflow-hidden text-ellipsis hover:text-stone-900 dark:hover:text-stone-100 cursor-pointer transition-colors duration-150 ease-out"
                  style={`padding-left:${item.indentLevel * 16}px`}
                  title={item.text}
                >
                  {item.text}
                </a>
              </div>
            ))}
          </nav>
        </div>
      )}
      {fullWidth && model.toc.length > 0 && (
        <div data-wide-toc class="fixed bottom-6 right-6 z-30 hidden md:block" data-open="false">
          <nav
            data-wide-toc-panel
            hidden
            aria-label="Table of contents"
            class="mb-2 max-h-[60vh] w-72 overflow-y-auto rounded-lg border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900 p-3 shadow-lg"
          >
            {model.toc.map(item => (
              <a
                href={`#${getHeadingAnchorId(item.id)}`}
                class="block w-full py-1.5 px-2 text-left text-sm rounded transition-colors duration-150 cursor-pointer text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-200/40 dark:hover:bg-stone-700/30"
                style={`padding-left:${item.indentLevel * 16 + 8}px`}
                title={item.text}
              >
                <span class="block whitespace-nowrap overflow-hidden text-ellipsis">{item.text}</span>
              </a>
            ))}
          </nav>
          <button
            type="button"
            data-wide-toc-toggle
            aria-label="Toggle table of contents"
            aria-expanded="false"
            class="flex h-11 w-11 items-center justify-center rounded-full border shadow-md transition-all duration-150 cursor-pointer border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-900 text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:border-stone-300 dark:hover:border-stone-600"
          >
            <svg data-wide-toc-list width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="6" x2="14" y2="6"></line>
              <line x1="4" y1="12" x2="18" y2="12"></line>
              <line x1="4" y1="18" x2="10" y2="18"></line>
            </svg>
            <svg data-wide-toc-close hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
          <span data-wide-toc-hover class="absolute bottom-full right-0 mb-2 max-w-[200px] truncate rounded bg-stone-800 dark:bg-stone-700 px-2 py-1 text-xs text-stone-100 dark:text-stone-200 pointer-events-none hidden"></span>
        </div>
      )}
    </div>
  </article>
  <div class={`px-4 flex justify-between font-medium text-stone-500 dark:text-stone-400 my-5 mx-auto ${contentWidthClass}`}>
    <a href={homeHref} class="group mt-2 flex items-center gap-1.5 cursor-pointer hover:text-stone-900 dark:hover:text-stone-100 transition-colors duration-150 ease-out">
      <span class="transition-transform duration-150 ease-out group-hover:-translate-x-0.5">←</span>
      {copy.POST.BACK}</a>
    <a href="#top" class="group mt-2 flex items-center gap-1.5 cursor-pointer hover:text-stone-900 dark:hover:text-stone-100 transition-colors duration-150 ease-out">
      <span class="transition-transform duration-150 ease-out group-hover:-translate-y-0.5">↑</span>
      {copy.POST.TOP}</a>
  </div>
  {showComments && (
    <CommentsIsland
      client:visible
      pageId={entry.pageId}
      title={entry.title}
      slug={publicSlugPath}
      fullWidth={fullWidth}
      locale={locale}
    />
  )}
</ArticleLayout>
