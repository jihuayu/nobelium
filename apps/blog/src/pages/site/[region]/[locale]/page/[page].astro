---
import BaseLayout from '@blog/layouts/BaseLayout.astro'
import PostCard from '@blog/components/PostCard.astro'
import Pagination from '@blog/components/Pagination.astro'
import { parseVariantParams } from '@blog/lib/variants'
import { filterGroupsForVariant, loadTranslationGroups } from '@blog/lib/policy-content'
import { config } from '@/lib/server/config'

export const prerender = false

const variant = parseVariantParams(Astro.params.region, Astro.params.locale)
const pageNumber = Number(Astro.params.page)
if (!variant || !Number.isInteger(pageNumber) || pageNumber < 1) {
  return new Response(null, { status: 404 })
}

const { region, locale } = variant
const groups = filterGroupsForVariant(await loadTranslationGroups(false), region, locale)
  .sort((a, b) => (b.translations[locale]?.date || 0) - (a.translations[locale]?.date || 0))
const start = (pageNumber - 1) * config.postsPerPage
const postsToShow = groups.slice(start, start + config.postsPerPage)
if (!postsToShow.length) {
  return new Response(null, { status: 404 })
}
const showNext = pageNumber * config.postsPerPage < groups.length
---

<BaseLayout region={region} locale={locale} title={locale === 'en' ? `Page ${pageNumber}` : `第 ${pageNumber} 页`}>
  {postsToShow.map(group => <PostCard group={group} locale={locale} />)}
  <Pagination locale={locale} page={pageNumber} showNext={showNext} />
</BaseLayout>
