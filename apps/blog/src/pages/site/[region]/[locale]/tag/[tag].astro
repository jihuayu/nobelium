---
import BaseLayout from '@blog/layouts/BaseLayout.astro'
import PostCard from '@blog/components/PostCard.astro'
import Tags from '@blog/components/Tags.astro'
import { buildPublicPath, getAllVariants } from '@blog/lib/variants'
import { collectTags, filterGroupsForVariant, loadTranslationGroups } from '@blog/lib/policy-content'
import type { Locale, RegionPolicy } from '@jihuayu/site-policy'

export async function getStaticPaths() {
  const groups = await loadTranslationGroups(false)
  const tagSet = new Set<string>()
  for (const group of groups) {
    for (const entry of Object.values(group.translations)) {
      if (!entry) continue
      for (const tag of entry.tags) tagSet.add(tag)
    }
  }

  const variants = getAllVariants()
  const paths = []
  for (const { region, locale } of variants) {
    for (const tag of tagSet) {
      paths.push({ params: { region, locale, tag } })
    }
  }
  return paths
}

const { region, locale, tag } = Astro.params as { region: RegionPolicy, locale: Locale, tag: string }
const decodedTag = decodeURIComponent(tag)
const groups = filterGroupsForVariant(await loadTranslationGroups(false), region, locale)
const tags = collectTags(groups, locale)
const filtered = groups.filter(group => (group.translations[locale]?.tags || []).includes(decodedTag))
const placeholder = `Search in #${decodedTag}`
---

<BaseLayout
  region={region}
  locale={locale}
  title={`#${decodedTag}`}
  searchIndexUrl={buildPublicPath('/search-index.json', locale)}
>
  <div class="relative">
    <label for="search-input" class="sr-only">{placeholder}</label>
    <input
      id="search-input"
      type="text"
      data-current-tag={decodedTag}
      placeholder={placeholder}
      class="block w-full rounded-md border px-4 py-2 border-stone-300 bg-transparent text-stone-900 placeholder:text-stone-400 transition-colors duration-150 ease-out focus:border-stone-400 dark:border-stone-700 dark:text-stone-100 dark:placeholder:text-stone-500 dark:focus:border-stone-500"
    />
    <svg class="absolute right-3 top-3 h-5 w-5 text-stone-400 dark:text-stone-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </div>
  <Tags tags={tags} locale={locale} currentTag={decodedTag} />
  <div id="search-results" class="article-container my-8" data-initial-results="true">
    {filtered.map(group => <PostCard group={group} locale={locale} />)}
  </div>
  <script>
    import '@blog/scripts/search'
  </script>
</BaseLayout>
