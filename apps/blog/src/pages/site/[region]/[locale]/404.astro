---
import BaseLayout from '@blog/layouts/BaseLayout.astro'
import { parseVariantParams } from '@blog/lib/variants'

export const prerender = false

const variant = parseVariantParams(Astro.params.region, Astro.params.locale)
if (!variant) {
  return new Response(null, { status: 404 })
}

const { region, locale } = variant
---

<BaseLayout region={region} locale={locale} title="404">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <h1 class="text-5xl font-serif font-semibold tracking-tight text-stone-900 dark:text-stone-100 text-center">404</h1>
  <p class="text-xl text-stone-500 dark:text-stone-400 text-center">Page not found</p>
</BaseLayout>
