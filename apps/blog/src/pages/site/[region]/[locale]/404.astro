---
import BaseLayout from '@blog/layouts/BaseLayout.astro'
import { getAllVariants } from '@blog/lib/variants'
import type { Locale, RegionPolicy } from '@jihuayu/site-policy'

export async function getStaticPaths() {
  return getAllVariants().map(({ region, locale }) => ({ params: { region, locale } }))
}

export const prerender = true

const { region, locale } = Astro.params as { region: RegionPolicy, locale: Locale }
---

<BaseLayout region={region} locale={locale} title="404">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <h1 class="text-5xl font-serif font-semibold tracking-tight text-stone-900 dark:text-stone-100 text-center">404</h1>
  <p class="text-xl text-stone-500 dark:text-stone-400 text-center">Page not found</p>
</BaseLayout>
